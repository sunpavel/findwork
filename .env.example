# Скопируй в .env и заполни. Файл .env в .gitignore — секреты в репозиторий не попадают.

# Telegram (см. docs/telegram_setup.md)
TG_BOT_TOKEN=
TG_CHAT_ID=

# HH.ru — официальный API (см. docs/hh_api.md).
# Регистрируешь приложение на https://dev.hh.ru/admin → получаешь client_id/secret.
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=
# Имя приложения и контакт в заголовке HH-User-Agent (по требованию HH).
HH_USER_AGENT=findwork/1.0 (sunpavel@gmail.com)
# Токен соискателя (если получаешь не через src/hh_auth.py, а вручную) — опционально.
# HH_ACCESS_TOKEN=

# --- LLM для адаптации резюме и сопроводительных (src/tailor.py) ---
# Провайдер: openai | anthropic. Если не задан — берётся openai при наличии
# OPENAI_API_KEY, иначе anthropic. Без ключей — детерминированный шаблон.
# LLM_PROVIDER=openai
#
# ⚠️ Гео-блок: с российских IP (напр. VPS Timeweb) OpenAI/Anthropic отдают 403
# "unsupported_country". Обход — одно из трёх:
#   0) БЕСПЛАТНО, без VPN: OpenRouter — OpenAI-совместимый шлюз, доступен из РФ,
#      есть бесплатные модели (id оканчивается на ":free"). Регистрация → ключ на
#      https://openrouter.ai/keys. Прописать:
#        LLM_PROVIDER=openai
#        OPENAI_BASE_URL=https://openrouter.ai/api/v1
#        OPENAI_API_KEY=sk-or-...           # ключ OpenRouter
#        OPENAI_MODEL=deepseek/deepseek-chat-v3-0324:free   # или другой ":free"
#      Список актуальных бесплатных моделей:
#        curl -s https://openrouter.ai/api/v1/models | \
#          python3 -c "import sys,json;print('\n'.join(m['id'] for m in json.load(sys.stdin)['data'] if m['id'].endswith(':free')))"
#      Лимиты free: ~20 запросов/мин, ~200/день — для бота откликов хватает.
#   1) совместимый прокси-эндпоинт (платный реселлер для РФ): свой ключ и адрес,
#      напр.:  OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
#      ANTHROPIC_BASE_URL=https://api.proxyapi.ru/anthropic
#   2) http(s)-прокси в поддерживаемой стране:  LLM_PROXY=http://user:pass@host:port
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# LLM_PROXY=

# OpenAI (ChatGPT):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5            # альтернативы: gpt-5-mini, gpt-4.1 (быстрее/дешевле)
# Глубина «раздумий» gpt-5/o-моделей: minimal (≈8с, по умолч.) | low | medium | high
# OPENAI_REASONING_EFFORT=minimal
#
# Anthropic (Claude):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
#
# Премиум-путь для РФ: ChatGPT через n8n (платный ключ OpenAI живёт в n8n-кредле,
# гео-блок api.openai.com не мешает — бот ходит на зарубежный n8n).
# Воркфлоу создаётся скриптом: tools/build_n8n_llm_webhook.py
# Если N8N_LLM_URL задан — career_agent сам выбирает провайдера n8n (писатель и критик).
# N8N_LLM_URL=https://solarn8n.pro/webhook/findwork-llm
# N8N_LLM_TOKEN=                 # общий секрет (заголовок X-Findwork-Token), если включён auth
# N8N_LLM_MODEL=gpt-4o           # модель OpenAI (можно задать и прямо в воркфлоу)
#
# Умная релевантность дайджеста (src/relevance_llm.py): LLM-судья ранжирует вакансии
# по реальному опыту/уровню из мастер-резюме (keyword-скоринг — лишь дешёвый пре-фильтр).
# Включён, если доступен LLM. Выключить (вернуться на keyword): RELEVANCE_LLM=0
# RELEVANCE_LLM=1

# --- n8n-дайджест (HH + facancy + Telegram-каналы + фильтр откликнутых) ---
# Живой дайджест — это n8n-воркфлоу. Перевыпуск: bash scripts/deploy_n8n.sh (берёт из .env).
# N8N_URL=https://solarn8n.pro
# N8N_KEY=                       # API-ключ n8n (Settings → n8n API → Create)
# N8N_WF_ID=                     # id воркфлоу; пусто → найдётся по имени (дубликат не создастся)
# HH_STATIC_TOKEN=               # сид-токен HH на случай лимита минта (опц.)
# Вебхук истории откликов: бот шлёт сюда список откликнутых, дайджест их исключает.
# N8N_APPLIED_URL=https://solarn8n.pro/webhook/findwork-applied
# N8N_APPLIED_TOKEN=             # общий секрет вебхука (заголовок X-Findwork-Token), опц.
# APPLIED_SYNC_SEC=7200          # как часто бот пушит историю откликов (по умолч. раз в 2ч)
# Список Telegram-каналов для ветки каналов (по умолчанию — src/sources.DEFAULT_TG_CHANNELS):
# TG_CHANNELS=@vacanciesrus,@finexecutive,@theypaywell

# --- Двухагентный пайплайн резюме/письма (src/career_agent.py) ---
# Пишет одна модель, проверяет другая (генератор + критик).
# Минимум проверяемых цифр из мастер-резюме в письме (борьба с «водой»): если меньше —
# QA-проход просит писателя дотянуть конкретику. По умолчанию 3.
# LETTER_MIN_METRICS=3
# Один проход (без критика) — быстрее, по умолчанию авто-вкл. для free-моделей
# (OpenAI-совместимый шлюз вида vendor/model). 1=всегда один проход, 0=всегда критик.
# CAREER_SINGLE_PASS=

# --- Фото в резюме ---
# Фото вставляется в PDF/DOCX, если оно есть. Проще всего — прислать фото боту в
# Telegram (он сохранит в resume/photo.jpg). Либо укажи свой путь здесь.
# RESUME_PHOTO=
# WRITER_PROVIDER=openai            # кто пишет
# WRITER_MODEL=gpt-5
# REVIEWER_PROVIDER=anthropic       # кто проверяет (Claude — нужен баланс на ключе)
# REVIEWER_MODEL=claude-opus-4-8
# Запасной проверяющий, если у основного нет ключа/кредитов:
# REVIEWER_FALLBACK_PROVIDER=openai
# REVIEWER_FALLBACK_MODEL=gpt-4.1

# --- Авто-отклик (серый путь: эмуляция приложения HH; см. docs/auto_apply.md) ---
# ⚠️ Нарушает ToS HH, риск блокировки аккаунта. Включаешь осознанно.
# Токен официального приложения HH. Проще всего получить через hh-applicant-tool
# (`hh-applicant-tool authorize`) — тогда переменные ниже не нужны, токен подхватится.
# HH_APP_ACCESS_TOKEN=
# Путь к state-файлу hh-applicant-tool, если он нестандартный:
# HH_APP_TOOL_STATE=
# User-Agent под мобильное приложение (по умолчанию мимикрия под ru.hh.android):
# HH_APP_USER_AGENT=ru.hh.android/7.0, Device: findwork, Android OS: 14

# Базовое резюме для адаптации (если не задано — берётся первое из твоих резюме):
# HH_BASE_RESUME_ID=
# Режим резюме: clone (новое под вакансию, по умолчанию) | update (правим базовое) | existing
# APPLY_RESUME_MODE=clone
# Дневной лимит откликов (вежливый, чтобы не ловить бан):
# APPLY_DAILY_LIMIT=30
# Пауза перед отправкой, сек (имитация человека):
# APPLY_PAUSE_SEC=2
